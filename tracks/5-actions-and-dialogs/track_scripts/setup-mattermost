#!/usr/bin/env bash
#
# Runs inside the Mattermost container. Ensures the server is running, then reports.
#
# WHY THIS DOES MORE THAN DIAGNOSE
#
# Mattermost starts as soon as the container does, which can be before the sandbox's
# internal DNS has a record for the `a-postgres` host. Mattermost retries the database for
# about ten seconds and then exits fatally:
#
#   "dial tcp: lookup a-postgres on 169.254.169.254:53: no such host"
#   "failed to initialize platform: cannot create store"  commands/server.go:75
#
# Nothing restarts it. PID 1 in an Instruqt container is the platform's own sandbox-agent,
# not Mattermost, and there is no restart policy, so a lost race means the server stays
# down for the life of the sandbox. That made track setup fail intermittently depending on
# whether DNS beat Mattermost by a few seconds.
#
# This script runs after the sandbox is wired up, so by the time it executes DNS resolves.
# It also runs after setup-a-postgres, because Instruqt orders setup scripts by hostname
# and the `a-` prefix encodes that (see track/config.yml).
# It confirms Postgres is reachable and relaunches the server if it died. Diagnostics are
# still printed on the way, because a different failure needs to be visible: lifecycle
# script stdout is the only log Instruqt surfaces, and each script sees one host.
#
# Never fails the track. The workbench setup already fails if Mattermost is truly down,
# and a diagnostic that can itself break the run is worse than no diagnostic.
#
set -uo pipefail

LOG=/mattermost/logs/mattermost.log
say() { echo "[mm] $*"; }

ping_ok() { curl -sf -m 3 http://localhost:8065/api/v4/system/ping >/dev/null 2>&1; }
mm_running() { pgrep -f '[m]attermost server' >/dev/null 2>&1 || pgrep -f '[/]mattermost/bin/mattermost' >/dev/null 2>&1; }

say "script is running, uid=$(id -u 2>/dev/null || echo '?')"
say "MM_ env var count: $(env 2>/dev/null | grep -c '^MM_' || echo 0)"

# Resolving and connecting to Postgres here proves DNS is ready, which is the precondition
# Mattermost needed and may not have had.
pg_ready=no
for _ in $(seq 1 30); do
    if timeout 3 bash -c 'echo > /dev/tcp/a-postgres/5432' 2>/dev/null; then
        pg_ready=yes
        break
    fi
    sleep 2
done
say "a-postgres:5432 reachable: ${pg_ready}"

# Give a healthy server a moment before concluding anything.
for _ in $(seq 1 20); do
    ping_ok && break
    sleep 2
done

if ping_ok; then
    say "server is up without intervention"
    say "body: $(curl -s -m 5 http://localhost:8065/api/v4/system/ping 2>/dev/null)"
    exit 0
fi

say "server is not answering. process running: $(mm_running && echo yes || echo no)"
say "log has a fatal store error: $(grep -qi 'cannot create store' "$LOG" 2>/dev/null && echo yes || echo no)"

if [ "$pg_ready" != yes ]; then
    say "Postgres is unreachable, so relaunching would only fail the same way. Giving up."
    exit 0
fi

if ! mm_running; then
    say "relaunching the server now that DNS resolves"
    mkdir -p /mattermost/logs
    # setsid so the server survives this script exiting: Instruqt may reap the script's
    # process group, and a plain background job would go with it.
    # su -m keeps the MM_* environment, which is how this deployment is configured.
    #
    # Wrapped in a respawn loop rather than started once. A single relaunch was enough to
    # satisfy this script and still leave the track broken: the server answered the ping
    # here, this script exited 0, and by the time the workbench waited for it the server
    # was gone again, so setup failed 5 minutes later on a host that cannot see this log.
    # Nothing supervises Mattermost in an Instruqt container. PID 1 is the sandbox agent
    # and there is no restart policy, so whatever kills it once wins permanently.
    #
    # The loop costs nothing when the server is healthy and makes a second death
    # self-healing whether the cause is a lost race, a reaped process, or a crash.
    ( cd /mattermost && setsid nohup bash -c \
        'while :; do su -m mattermost -c "/mattermost/bin/mattermost server"; echo "[mm] server exited, respawning in 5s"; sleep 5; done' \
        >> /mattermost/logs/relaunch.log 2>&1 & ) 2>/dev/null

    for _ in $(seq 1 60); do
        ping_ok && break
        sleep 2
    done

    if ping_ok; then
        # Do not trust the first successful ping. The failure this is guarding against
        # answered a ping and then died, so confirm it is still serving a little later.
        # 30s is not a guarantee, but it separates "started and stayed up" from "started
        # and immediately died again", and the workbench does not begin waiting instantly.
        say "relaunch answered a ping, confirming it stays up"
        # 90s rather than 30s, to time the death rather than just detect it. A run held for
        # 30s here and was unreachable from the workbench 74s later. If the server holds a
        # full 90s and still dies before the workbench sees it, the death is tied to this
        # script exiting rather than to anything the server did, which is the difference
        # between a crash to debug and a reaped process group.
        stable=yes
        for _ in $(seq 1 30); do
            sleep 3
            ping_ok || { stable=no; break; }
        done

        if [ "$stable" = yes ]; then
            say "relaunch succeeded and held for 90s: $(curl -s -m 5 http://localhost:8065/api/v4/system/ping 2>/dev/null)"
            exit 0
        fi

        # It died after answering. This is the case that produced a green setup-mattermost
        # and a failed track, so say so loudly and dump what the old code threw away.
        say "WARNING: the server answered and then stopped responding again."
        say "The respawn loop above should bring it back, but here is why it died:"
        while IFS= read -r line; do say "relaunch ${line:0:300}"; done < <(tail -20 /mattermost/logs/relaunch.log 2>/dev/null)
        while IFS= read -r line; do say "err ${line:0:300}"; done < <(grep -iE '"level":"(error|fatal|panic)"' "$LOG" 2>/dev/null | tail -8)

        # Give the respawn loop a chance before handing over to the workbench, which fails
        # the track if it cannot reach Mattermost.
        for _ in $(seq 1 60); do
            ping_ok && break
            sleep 2
        done
        if ping_ok; then
            say "the respawn loop recovered the server"
            exit 0
        fi
        say "the server is still down after waiting for the respawn loop"
    fi
    say "relaunch did not bring the server up. Last relaunch output:"
    while IFS= read -r line; do say "relaunch ${line:0:300}"; done < <(tail -15 /mattermost/logs/relaunch.log 2>/dev/null)
fi

# Still down, so dump everything useful.
while IFS= read -r line; do say "env ${line}"; done < <(env 2>/dev/null | grep '^MM_' | sort)

if [ -f "$LOG" ]; then
    while IFS= read -r line; do
        say "err ${line:0:300}"
    done < <(grep -iE '"level":"(error|fatal|panic)"' "$LOG" 2>/dev/null | tail -8)
fi

exit 0
