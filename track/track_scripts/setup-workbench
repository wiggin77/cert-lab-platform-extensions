#!/usr/bin/env bash
#
# Track setup, runs on the `workbench` VM.
#
# Mattermost and Postgres are separate container hosts, so nothing here provisions them.
# This script's job is the VM: toolchains, the lab code, and the services.
#
# Learners cannot start until this exits 0, and it is the slowest thing in the track by a
# wide margin. It also runs LAST: Instruqt orders setup scripts by hostname and runs them
# serially, so the learner's wait is this script plus every other host's, not the longest of
# them.
#
# It prints its own phase breakdown, so read the summary at the end of a run rather than
# guessing where the time went. Hot start is ruled out on cost (you are billed for unclaimed
# pre-warmed sandboxes), so the fix has to make this script genuinely faster: bake a custom
# VM image with the toolchains and caches already present, and overlap the independent
# downloads and compiles, which today run strictly one after another.
#
set -euo pipefail

REPO_URL="${LAB_REPO_URL:-https://github.com/wiggin77/cert-lab-platform-extensions}"
REPO_REF="${LAB_REPO_REF:-main}"

LAB_ROOT=/opt/lab
LEARNER=learner
LEARNER_HOME=/home/learner
LAB_ENV=/etc/lab.env

NODE_MAJOR=22

# Must stay at or above the `go` directive in plugin/go.mod, which is set by
# github.com/mattermost/mattermost/server/public and is currently 1.24.11. An older
# toolchain does not fail with "upgrade your Go": it tries to download a newer one, and
# that hangs or fails as a service user with no writable cache.
GO_VERSION=1.25.5

log() { echo "[setup] $*"; }

# ---------------------------------------------------------------------------
# Phase timing
# ---------------------------------------------------------------------------
# This script's stdout is the only thing Instruqt surfaces, so printing the breakdown is
# the only way to learn where the time goes. Without it the whole cost is one aggregate
# number and the three candidate fixes are indistinguishable: baking a custom VM image
# helps if the cost is installing and compiling, a larger boot disk helps if it is writing
# ~600 MB of caches to a 10 GB PD, and a larger machine_type helps if it is CPU. Those are
# very different amounts of work to buy.
#
# SECONDS is a bash builtin holding whole seconds since the shell started, so this costs no
# subprocesses. Every helper returns 0 explicitly: instrumentation that can fail the track
# is worse than no instrumentation, and `set -e` would take a bare non-zero return as fatal.
PHASE_NAME=""
PHASE_START=0
PHASE_LOG=()

phase() {
    local now=$SECONDS
    if [ -n "$PHASE_NAME" ]; then
        PHASE_LOG+=("$((now - PHASE_START))s ${PHASE_NAME}")
        log "  ^ ${PHASE_NAME}: $((now - PHASE_START))s (${now}s into setup)"
    fi
    PHASE_NAME="${1:-}"
    PHASE_START=$now
    [ -n "$PHASE_NAME" ] && log "> ${PHASE_NAME}"
    return 0
}

# On EXIT, so a run that fails halfway still reports what it got through. That is the case
# where the breakdown matters most, and it is the case a summary printed just before
# `exit 0` would miss.
phase_summary() {
    local code=$?
    phase "" || true
    log "=============================================================="
    log "setup timing, longest first. total ${SECONDS}s, exit ${code}"
    if [ "${#PHASE_LOG[@]}" -gt 0 ]; then
        printf '%s\n' "${PHASE_LOG[@]}" | sort -rn | sed 's/^/[setup]   /' || true
    fi
    log "=============================================================="
    return 0
}
trap phase_summary EXIT

# Which resource is scarce is not answerable from the phase times alone, so record the
# shape of the machine they were measured on.
log "machine: $(nproc 2>/dev/null || echo '?') vCPU, root fs $(df -h / 2>/dev/null | awk 'NR==2{print $2" total, "$4" free"}' || echo '?')"

wait_for() {
    local url="$1" name="$2" tries="${3:-90}" unit="${4:-}"
    log "waiting for ${name}"
    for _ in $(seq 1 "$tries"); do
        curl -sf -m 3 "$url" >/dev/null 2>&1 && { log "${name} is up"; return 0; }
        sleep 2
    done

    echo "[setup] FAILED: ${name} never came up at ${url}" >&2

    # A service that does not answer has almost always died with a reason in its journal.
    # Instruqt surfaces nothing but this script's own output, so print the reason here
    # rather than making the next run the diagnostic.
    if [ -n "$unit" ]; then
        echo "[setup] --- systemctl is-active ${unit}: $(systemctl is-active "$unit" 2>&1)" >&2
        echo "[setup] --- last 40 journal lines for ${unit}:" >&2
        journalctl -u "$unit" -n 40 --no-pager 2>&1 | sed 's/^/[setup]   /' >&2
    fi
    return 1
}

# ---------------------------------------------------------------------------
# 1. Base packages and toolchains
# ---------------------------------------------------------------------------
log "installing base packages"
export DEBIAN_FRONTEND=noninteractive

# Retry the install itself rather than probing apt for readiness. A probe on package
# metadata was misleading: apt reported a healthy update (35 MB fetched, all sources hit)
# while the probe still said the lists were unusable. What matters is whether the packages
# install, so ask that question directly and show the real error when they do not.
install_pkgs() {
    local attempt
    for attempt in 1 2 3; do
        apt-get update >/dev/null 2>&1 || true
        if apt-get install -y -qq "$@" >/tmp/apt-install.log 2>&1; then
            return 0
        fi
        log "apt install of '$*' failed (attempt ${attempt}):"
        tail -8 /tmp/apt-install.log | sed 's/^/[setup]   apt: /'
        sleep 10
    done
    return 1
}

# make is in this list, not in build-essential below, because Module 6's plugin build is
# driven by a Makefile. build-essential is allowed to fail; make is not.
phase "apt base packages"
install_pkgs git curl jq make ca-certificates || {
    echo "[setup] FAILED: could not install base packages" >&2
    exit 1
}

# Only needed if a native npm module or a cgo build shows up. Neither has, and Mattermost
# plugins build with CGO_ENABLED=0, so its absence must not stop the track. It went
# missing on a stock jammy image once, hence the diagnostic.
phase "apt build-essential"
if ! install_pkgs build-essential; then
    log "build-essential unavailable, continuing without it. apt says:"
    apt-cache policy build-essential 2>&1 | sed 's/^/[setup]   /'
fi

phase "install Node ${NODE_MAJOR}"
log "installing Node ${NODE_MAJOR}"
curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - >/dev/null 2>&1
apt-get install -y -qq nodejs >/dev/null
log "node $(node --version), npm $(npm --version)"

# Go is only needed for Module 6, but installing it here rather than in that challenge's
# setup keeps challenge-level setup trivial, and means a learner never waits mid-challenge
# with a 30 minute timer running. Measured at 3s, so it is not what makes setup slow.
phase "install Go ${GO_VERSION}"
log "installing Go ${GO_VERSION}"
curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz
rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
ln -sf /usr/local/go/bin/go /usr/local/bin/go
ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
log "$(go version)"

# ---------------------------------------------------------------------------
# 2. Learner account and lab code
# ---------------------------------------------------------------------------
id -u "$LEARNER" >/dev/null 2>&1 || useradd -m -s /bin/bash "$LEARNER"

phase "git clone lab repo"
log "cloning ${REPO_URL} @ ${REPO_REF}"
rm -rf "$LAB_ROOT"
git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$LAB_ROOT" 2>&1 | sed 's/^/[setup]   /'

phase "npm ci labsvc"
log "installing labsvc dependencies"
# Not --omit=dev. Both services run their TypeScript directly under tsx with no build
# step, so tsx is a runtime dependency even though package.json lists it under
# devDependencies. Omitting dev deps here left tsx missing, npx then tried to fetch it
# from the network as a nologin user with no HOME, and the service never started.
npm --prefix "${LAB_ROOT}/labsvc" ci --no-audit --no-fund >/dev/null

# The learner gets their own copy. /opt/lab stays pristine so a reset can restore from it,
# and so grading code is not sitting in a directory the learner can edit.
phase "npm ci handler"
log "installing the learner handler"
rm -rf "${LEARNER_HOME}/handler"
cp -r "${LAB_ROOT}/handler" "${LEARNER_HOME}/handler"
npm --prefix "${LEARNER_HOME}/handler" ci --no-audit --no-fund >/dev/null

# The Module 6 plugin scaffold. Same reasoning as the handler: the learner edits their own
# copy and /opt/lab stays pristine.
phase "copy plugin scaffold"
log "installing the plugin scaffold"
rm -rf "${LEARNER_HOME}/plugin"
cp -r "${LAB_ROOT}/plugin" "${LEARNER_HOME}/plugin"

chmod +x "${LAB_ROOT}"/labsvc/scripts/*.sh "${LAB_ROOT}"/variants/*.sh "${LAB_ROOT}"/bin/*
ln -sf "${LAB_ROOT}/labsvc/scripts/fire-alert.sh" /usr/local/bin/fire-alert.sh
# The assignments tell the learner to run these, so they need to be on PATH.
for helper in lab-set-webhook lab-set-token; do
    ln -sf "${LAB_ROOT}/bin/${helper}" "/usr/local/bin/${helper}"
done

# ---------------------------------------------------------------------------
# 3. Wait for Mattermost, which is provisioning in parallel as its own host
# ---------------------------------------------------------------------------
# Expected to be ~0s: setup scripts serialise by hostname, so setup-mattermost has already
# run to completion. A non-trivial number here means the server died after that script
# confirmed it.
phase "wait for Mattermost"
if ! wait_for http://mattermost:8065/api/v4/system/ping "Mattermost" 150; then
    echo "[setup] Mattermost runs on its own host, so its logs are not here." >&2
    echo "[setup] Look for the setup-mattermost output in this track log: it reports" >&2
    echo "[setup] whether Postgres was reachable and whether a relaunch was attempted." >&2

    # Which layer failed is the whole question, and it is not answerable from the other
    # host's log: setup-mattermost has already exited by the time this runs, and it reported
    # success. A run where it says "relaunch succeeded and held for 30s" and this says
    # "never came up" means the server died in between, or was never reachable from here.
    # Those need opposite fixes, so probe each layer separately and say which one broke.
    #
    #   DNS fails                -> sandbox networking, not Mattermost
    #   DNS ok, TCP refused      -> nothing is listening, so the process is gone
    #   TCP ok, HTTP no answer   -> process alive but not serving, look at its own log
    echo "[setup] --- probing each layer from this host ---" >&2
    echo "[setup] DNS for 'mattermost': $(getent hosts mattermost 2>&1 || echo 'DOES NOT RESOLVE')" >&2

    if timeout 5 bash -c 'echo > /dev/tcp/mattermost/8065' 2>/dev/null; then
        echo "[setup] TCP to mattermost:8065: OPEN, so a process is listening" >&2
        echo "[setup] So the port answers but the API does not. Mattermost is up and not" >&2
        echo "[setup] serving, which points at its own startup, not at the network." >&2
    else
        echo "[setup] TCP to mattermost:8065: REFUSED or unreachable" >&2
        echo "[setup] So nothing is listening. Either the server died after" >&2
        echo "[setup] setup-mattermost confirmed it, or the respawn loop there was reaped" >&2
        echo "[setup] when that script exited." >&2
    fi

    # curl's own exit code separates a connection failure (7) from a timeout (28), which is
    # the same distinction one level up and costs nothing to record.
    curl -sf -m 5 http://mattermost:8065/api/v4/system/ping >/dev/null 2>&1
    echo "[setup] curl exit code: $? (7 = could not connect, 28 = timed out, 0 = fine)" >&2

    exit 1
fi

# ---------------------------------------------------------------------------
# 4. Seed, and write the environment both services read
# ---------------------------------------------------------------------------
# lab-seed creates the team, channels, users, bot, and tokens, and appends the ids it
# creates to LAB_ENV.
phase "write lab.env and seed Mattermost"
log "seeding Mattermost"
cat > "$LAB_ENV" <<EOF
# Written by track setup. Shared by mm-labsvc and mm-handler.
LABSVC_HOST=0.0.0.0
LABSVC_PORT=4000
LABSVC_PUBLIC_BASE_URL=http://workbench:4000
HANDLER_URL=http://127.0.0.1:3000
# MM_URL is deliberately NOT here. The two services need different values for it, and
# systemd's EnvironmentFile= overrides Environment= unconditionally (not by file order),
# so a value here would win over any per-unit override. Each unit sets its own below.
MM_SITE_URL=http://mattermost:8065
JOURNAL_PATH=/var/lib/labsvc/journal.jsonl
INTEL_API_URL=http://workbench:4000/mock/intel/v1
FEED_INTERVAL_MS=60000
FEED_AUTOSTART=false
# The learner's own payload builder. Without this the feed falls back to plain text and
# every Module 2 formatting check fails no matter what the learner writes, because their
# code is never loaded.
FEED_PAYLOAD_MODULE=${LEARNER_HOME}/handler/src/payloads/alert-payload.ts
SLASH_ACK_BUDGET_MS=3000
LAB_MODULE=2
LOG_LEVEL=info
EOF

"${LAB_ROOT}/bin/lab-seed"

# The learner has to be able to read this. Module 6 tells them to run `make deploy`, which
# uploads a plugin over the REST API, and that needs the admin token. Instruqt runs
# lifecycle scripts under a umask that leaves the file mode 600, so without this the
# deploy fails with "No admin token" while everything else about the build succeeded.
#
# This is not a security boundary being dropped. The learner has sudo, so the token was
# always reachable, and plugin installation is an admin operation by definition.
chmod 644 "$LAB_ENV"

# Assert it, rather than assuming the chmod above was the whole story. If something else
# is blocking the read (a directory mode, a mount option), this says so here instead of
# surfacing 20 minutes later as a failed plugin deploy.
if su -l "$LEARNER" -c "test -r ${LAB_ENV}"; then
    log "${LAB_ENV} is readable by ${LEARNER} (mode $(stat -c %a "$LAB_ENV"))"
else
    log "WARNING: ${LEARNER} cannot read ${LAB_ENV} (mode $(stat -c %a "$LAB_ENV")). Module 6's make deploy will fail."
fi

# lab-configure-agents runs later, after mm-labsvc is up. It points the Agents plugin at
# the mock LLM and then probes that the mock answers, and the probe cannot pass before the
# service serving it exists. Running it here made that check dead code: it warned on every
# single run, which trains you to ignore the one time it means something.

mkdir -p /var/lib/labsvc
chown -R "${LEARNER}:${LEARNER}" "$LEARNER_HOME"

# labsvc runs as its own user and imports the learner's payload builder from their home
# directory, so that path has to be readable by another account. useradd -m can produce a
# 750 home depending on the image's login.defs, which would make the import fail with a
# permission error that looks like the learner's code being broken.
chmod 755 "$LEARNER_HOME"

# ---------------------------------------------------------------------------
# 4b. Warm the plugin build caches
# ---------------------------------------------------------------------------
# Module 6 opens with `make deploy`. Without this, that first build downloads the whole
# Go module graph and the webpack toolchain while the learner watches a stalled terminal,
# inside a 30 minute challenge timer.
#
# THIS IS THE EXPENSIVE PART OF SETUP, by a wide margin. The trade is deliberate, because
# the alternative spends it inside a timed challenge instead of on the loading screen, but
# it is the first thing to attack, and baking a custom VM image removes it outright.
#
# The four phases below are timed separately on purpose. Do not re-lump them: which of
# download, compile, and npm dominates is what decides whether the answer is baked caches,
# a bigger machine_type, or a bigger boot disk.
#
# It runs as the learner, not root, and that matters: a module cache under /root is not
# readable by them, so the download would silently happen again on first build. Same for
# node_modules, which would additionally end up root owned and unwritable.
#
# Non-fatal. A network hiccup here costs the learner time, but the track still works.
log "warming the plugin build caches"

# The download and the compile are run as two commands rather than one so the timing can
# separate them. They are bound by different resources, network and disk versus CPU, and
# they point at different fixes. Lumping them is how this section's cost came to be
# attributed to "fetching and compiling the Go dependency tree" without evidence for the
# split.
phase "go mod download"
if ! su -l "$LEARNER" -c "cd ~/plugin && go mod download" >/tmp/plugin-warm-go.log 2>&1; then
    log "WARNING: the Go module download failed, Module 6's first build will be slow:"
    tail -5 /tmp/plugin-warm-go.log | sed 's/^/[setup]   /'
fi

# `go test -run` with a pattern that matches nothing compiles the test binary without
# running it. That is deliberate: it pulls the test-only dependencies into the cache as
# well as the build ones, so `make test` is also instant. `go mod download` alone leaves
# testify to be fetched on first use.
phase "go compile test binary"
if ! su -l "$LEARNER" -c "cd ~/plugin && go test -run XXXNoSuchTest ./server/" \
    >>/tmp/plugin-warm-go.log 2>&1; then
    log "WARNING: warming the Go build cache failed, Module 6's first build will be slow:"
    tail -5 /tmp/plugin-warm-go.log | sed 's/^/[setup]   /'
fi

phase "npm install plugin webapp"
if ! su -l "$LEARNER" -c "cd ~/plugin/webapp && npm install --no-audit --no-fund" >/tmp/plugin-warm-npm.log 2>&1; then
    log "WARNING: npm install for the plugin webapp failed:"
    tail -5 /tmp/plugin-warm-npm.log | sed 's/^/[setup]   /'
fi

# Build both halves once, so a broken scaffold surfaces here rather than as the learner's
# first experience of Module 6.
phase "make bundle"
if ! su -l "$LEARNER" -c "cd ~/plugin && make bundle" >/tmp/plugin-warm-build.log 2>&1; then
    log "WARNING: the plugin scaffold does not build:"
    tail -20 /tmp/plugin-warm-build.log | sed 's/^/[setup]   /'
fi

# Bytes written, so the phase times above can be read as throughput rather than just
# duration. Slow phases against this volume mean the boot disk is the constraint, which a
# larger disk on a custom image fixes more cheaply than baking the caches themselves.
log "cache sizes after warming:"
for d in "go/pkg/mod" ".cache/go-build" "plugin/webapp/node_modules"; do
    log "  ${d}: $(du -sh "${LEARNER_HOME}/${d}" 2>/dev/null | cut -f1 || echo '?')"
done

# ---------------------------------------------------------------------------
# 5. Services
# ---------------------------------------------------------------------------
# labsvc runs as its own user so the journal file is not writable by the learner. That
# only defeats casual tampering, since the learner has sudo, which is the right level:
# labs are formative and the exam is the real gate.
phase "write systemd units"
id -u labsvc >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin labsvc
chown -R labsvc:labsvc /var/lib/labsvc

write_unit() {
    cat > "/etc/systemd/system/$1.service"
    log "wrote unit $1"
}

write_unit mm-labsvc <<EOF
[Unit]
Description=Certification lab services
After=network-online.target
# StartLimitIntervalSec belongs in [Unit], NOT [Service]. Modern systemd ignores it
# under [Service] with an "Unknown key name" warning, so putting it there looks
# like a fix and changes nothing.
#
# Never give up restarting. The default start limit is 5 attempts in 10s, and with
# RestartSec=2 that is only a few crash-loops from systemd refusing to start the
# unit at all, leaving it dead with "start request repeated too quickly". Restarts
# cluster in this lab: lab-module.sh bounces labsvc at every challenge boundary, and
# lab-set-webhook and lab-set-token bounce it again when the learner registers
# something. One transient crash on top of that left labsvc permanently dead and a
# challenge that could not be checked at all.
StartLimitIntervalSec=0

[Service]
Type=simple
User=labsvc
WorkingDirectory=${LAB_ROOT}/labsvc
EnvironmentFile=${LAB_ENV}
# labsvc IS the proxy, so it addresses Mattermost directly. See the note in LAB_ENV.
Environment=MM_URL=http://mattermost:8065
# The local binary, not npx. npx falls back to a network fetch when the package is
# missing, which turns a dependency problem into a hang, and it wants a writable cache
# directory that a nologin service user does not have.
Environment=HOME=/tmp
ExecStart=${LAB_ROOT}/labsvc/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=2
# Bound the stop phase. systemctl restart waits for the unit to stop before starting
# it, and with no timeout here the systemd default of 90s applies, so a process that
# is slow to die would stall the learner's terminal for a minute and a half per
# restart. SIGKILL after 10s instead. KillMode=mixed sends SIGTERM to the main
# process and SIGKILL to anything left in the cgroup, which matters because tsx runs
# the service as a child.
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
EOF

write_unit mm-handler <<EOF
[Unit]
Description=Learner integration handler
After=network-online.target
# StartLimitIntervalSec belongs in [Unit], NOT [Service]. Modern systemd ignores it
# under [Service] with an "Unknown key name" warning, so putting it there looks
# like a fix and changes nothing.
#
# Never give up restarting. The default start limit is 5 attempts in 10s, and with
# RestartSec=2 that is only a few crash-loops from systemd refusing to start the
# unit at all, leaving it dead with "start request repeated too quickly". Restarts
# cluster in this lab: lab-module.sh bounces labsvc at every challenge boundary, and
# lab-set-webhook and lab-set-token bounce it again when the learner registers
# something. One transient crash on top of that left labsvc permanently dead and a
# challenge that could not be checked at all.
StartLimitIntervalSec=0

[Service]
Type=simple
User=${LEARNER}
WorkingDirectory=${LEARNER_HOME}/handler
EnvironmentFile=${LAB_ENV}
Environment=HOME=${LEARNER_HOME}
# The handler goes THROUGH the proxy, so its REST calls are recorded and the learner can
# see them in the Lab Inspector. Without this the outbound proxy records nothing and the
# Module 5 dialog check cannot see the dialog definition even though the dialog opened.
#
# This only works because MM_URL is absent from LAB_ENV. systemd documents that settings
# from EnvironmentFile= "override settings made with Environment=", unconditionally rather
# than by the order they appear in the unit, so a value in the shared file would win here.
Environment=MM_URL=http://workbench:4000/mm
# tsx watch, so a saved edit reloads without the learner restarting anything.
ExecStart=${LEARNER_HOME}/handler/node_modules/.bin/tsx watch src/index.ts
Restart=always
RestartSec=2
# Bound the stop phase. systemctl restart waits for the unit to stop before starting
# it, and with no timeout here the systemd default of 90s applies, so a process that
# is slow to die would stall the learner's terminal for a minute and a half per
# restart. SIGKILL after 10s instead. KillMode=mixed sends SIGTERM to the main
# process and SIGKILL to anything left in the cgroup, which matters because tsx runs
# the service as a child.
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
EOF

phase "install code-server"
log "installing code-server"
curl -fsSL https://code-server.dev/install.sh | sh >/dev/null 2>&1
mkdir -p "${LEARNER_HOME}/.config/code-server"
cat > "${LEARNER_HOME}/.config/code-server/config.yaml" <<EOF
bind-addr: 0.0.0.0:8080
auth: none
cert: false
EOF
chown -R "${LEARNER}:${LEARNER}" "${LEARNER_HOME}/.config"

phase "start services"
systemctl daemon-reload
systemctl enable --now mm-labsvc
wait_for http://localhost:4000/healthz "labsvc" 60 mm-labsvc

systemctl enable --now mm-handler
wait_for http://localhost:3000/healthz "handler" 60 mm-handler

systemctl enable --now "code-server@${LEARNER}"

# Now that the mock LLM is actually being served, point the Agents plugin at it. Non-fatal:
# everything except Module 6's AI skills works without it.
phase "configure Agents plugin"
"${LAB_ROOT}/bin/lab-configure-agents" || log "WARNING: Agents setup failed, Module 6 AI skills will not work"

log "setup complete"
exit 0
