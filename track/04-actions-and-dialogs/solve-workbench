#!/usr/bin/env bash
#
# Applies the worked solution for this challenge.
#
# Unlike challenges 1 to 3, there is nothing to configure in Mattermost here. Interactive
# elements are declared in the message itself, so the whole solution is code.
#
set -euo pipefail

HANDLER_DIR=/home/learner/handler /opt/lab/variants/apply-variant.sh mod5 solution
chown -R learner:learner /home/learner/handler

# tsx watch reloads on save, but this variant replaces two route files, so give it a moment
# to settle before the platform runs the check.
sleep 4
exit 0
