#!/usr/bin/env bash
#
# Applies the worked solution for module 6, challenge 2.
#
# This variant carries both halves: the webapp components and the server side analyze
# endpoint the sidebar buttons call. The webapp cannot reach the KV Store itself, so the
# two always ship together.
#
# It also applies mod6-server first. The solve scripts have to stand alone, because CI
# runs a single challenge's solve against that challenge's checks, and this challenge's
# checks depend on the previous one's endpoints existing.
#
set -euo pipefail

PLUGIN_DIR=/home/learner/plugin

PLUGIN_DIR="$PLUGIN_DIR" /opt/lab/variants/apply-variant.sh mod6-server solution
PLUGIN_DIR="$PLUGIN_DIR" /opt/lab/variants/apply-variant.sh mod6-webapp solution
chown -R learner:learner "$PLUGIN_DIR"

exec /opt/lab/bin/lab-deploy-plugin
