#!/usr/bin/env bash
#
# Installs the Mattermost Agents plugin and points it at the lab's mock LLM.
#
# The mock LLM is OpenAI compatible and deterministic, which is what keeps an API key out
# of a public sandbox, removes per-learner token cost, works offline, and gives the
# Module 6 grader text it can assert against. See DESIGN.md section 5.3.
#
# The config shape below is taken from the plugin source at v2.2.0
# (config/config.go and llm/configuration.go), not from documentation:
#
#   Config.services[] -> llm.ServiceConfig { id, name, type, apiKey, apiURL, defaultModel }
#   Config.bots[]     -> llm.BotConfig     { id, name, displayName, serviceID, ... }
#
# Non-fatal by design. Track setup tolerates a failure here, because everything except
# Module 6's AI skills still works without it.
#
set -euo pipefail
SCRIPT_NAME=lab-configure-agents
# shellcheck source=lab-common.sh
source "$(dirname "$(readlink -f "$0")")/lab-common.sh"

PLUGIN_ID=mattermost-ai

# Pinned to v2.2.0, and the ceiling is not arbitrary: v2.4.x raised min_server_version to
# 11.9.0 and the lab runs Mattermost 10.5, so it cannot be installed here at all. v2.2.0
# still declares 6.2.1 and already has the LLM Bridge (public/bridgeclient plus the
# /bridge/v1 routes) that Module 6's AI skill calls. v1.x has no bridge.
#
# Raising the Mattermost image is the way to move past v2.2.0, not bumping this alone.
PLUGIN_VERSION="${AGENTS_VERSION:-v2.2.0}"
# The release also publishes -fips builds. Use the plain linux-amd64 archive.
PLUGIN_URL="https://github.com/mattermost/mattermost-plugin-agents/releases/download/${PLUGIN_VERSION}/mattermost-plugin-agents-${PLUGIN_VERSION}-linux-amd64.tar.gz"

SERVICE_ID=lab-mock-llm
BOT_NAME=threat-analyst
MOCK_LLM_URL="${LABSVC_PUBLIC_BASE_URL:-http://workbench:4000}/mock/llm/v1"

MM_ADMIN_TOKEN="${MM_ADMIN_TOKEN:-$(lab_env_get MM_ADMIN_TOKEN || true)}"
[ -n "$MM_ADMIN_TOKEN" ] || die "MM_ADMIN_TOKEN not available. Run lab-seed first."
export MM_ADMIN_TOKEN

wait_for_mattermost 60

# ---------------------------------------------------------------------------
# 1. Configure, BEFORE installing. Do not reorder these two sections.
# ---------------------------------------------------------------------------
# Agents 2.x reads PluginSettings exactly once, ever.
#
# On its first activation it checks store.IsConfigMigrated(), and if false it loads
# PluginSettings, writes the result to its own database table, and marks itself migrated
# (server/main.go). From then on it reads only the database, and v2.2.0 has no
# OnConfigurationChange hook, so nothing written to PluginSettings afterwards is ever seen
# again.
#
# Configuring after enabling therefore looked like it worked and did nothing: the plugin
# migrated whatever was there at activation (the old bundled version's config, i.e.
# nothing), our services and bots were written to a file the plugin had stopped reading,
# and the whole failure surfaced two challenges later as a bridge 404 naming the service.
#
# Writing the config first means it is already in place whenever the new version first
# activates, so the migration picks it up. A bounce cannot substitute for this: a restart
# is a SECOND activation, and by then migration has already happened.
#
# Known limit: if a sandbox somehow has 2.x already installed AND migrated, this script
# cannot correct its stored config, because there is no API to re-run the migration. Track
# runs start from a fresh sandbox with the older bundled build, so that case does not arise
# here.
#
# apiKey must be non-empty. The Agents plugin rejects a blank key even for a local,
# OpenAI compatible service, which fails every model fetch and inference call with a
# "No valid keys" error. The value itself is never checked by the mock.
log "pointing Agents at ${MOCK_LLM_URL}"

read -r -d '' PLUGIN_CONFIG <<JSON || true
{
  "services": [
    {
      "id": "${SERVICE_ID}",
      "name": "Lab Mock LLM",
      "type": "openaicompatible",
      "apiURL": "${MOCK_LLM_URL}",
      "apiKey": "lab-dummy-key-must-not-be-blank",
      "defaultModel": "lab-threat-analyst-v1",
      "tokenLimit": 8192
    }
  ],
  "bots": [
    {
      "id": "${BOT_NAME}",
      "name": "${BOT_NAME}",
      "displayName": "Threat Analyst",
      "serviceID": "${SERVICE_ID}",
      "customInstructions": "You are a security operations analyst assistant. Be concise and specific.",
      "model": "lab-threat-analyst-v1",
      "enableVision": false,
      "disableTools": true,
      "channelAccessLevel": 0,
      "userAccessLevel": 0
    }
  ],
  "defaultBotName": "${BOT_NAME}",
  "allowedUpstreamHostnames": "workbench",
  "enableCallSummary": false,
  "enableTokenUsageLogging": false
}
JSON

# Nest the plugin config under PluginSettings.Plugins.<id> and validate it as JSON on the
# way through, so a typo in the heredoc fails here rather than silently half-configuring
# the plugin.
# Everything goes under a single "Config" key, and that nesting is the whole ballgame.
#
# The Agents plugin declares exactly one setting in its plugin.json settings_schema,
# "Config", and loads it into a struct whose only field is `config.Config` carrying an
# explicit `json:"config"` tag. An explicit tag on an embedded field makes it a NAMED
# field rather than an inlined one, so the services and bots arrays have to sit inside a
# "config" object. Written at the top level instead they are simply not seen.
#
# Nothing complains when this is wrong, which is what made it expensive: the settings are
# stored verbatim, the plugin's one-shot config migration runs and reports success, and it
# migrates an empty config. EnsureBots then has no bots to create, returns no error, and
# the only symptom is the LLM Bridge answering "no bot found for service" two challenges
# later.
BODY=$(PLUGIN_CONFIG="$PLUGIN_CONFIG" python3 - "$PLUGIN_ID" <<'PY'
import json, os, sys
cfg = json.loads(os.environ["PLUGIN_CONFIG"])
print(json.dumps({"PluginSettings": {"Plugins": {sys.argv[1]: {"Config": cfg}}}}))
PY
) || die "the plugin configuration is not valid JSON"

mm PUT /config/patch "$BODY" >/dev/null || die "could not write the Agents plugin configuration"

# ---------------------------------------------------------------------------
# 2. Install
# ---------------------------------------------------------------------------
# ORDER MATTERS: the configuration above must already be written before this runs. See the
# note at the top of section 1.
#
# Compare VERSIONS, not mere presence.
#
# The Mattermost image ships a prepackaged mattermost-ai, so a presence check always
# reported "already installed" and this script never installed anything. The bundled build
# predates the LLM Bridge, so the plugin has no /bridge/v1 routes, and a request to one
# falls through to gin's NoRoute handler. That still runs the router's global middleware,
# including the one requiring a Mattermost-User-Id, so an inter-plugin call (which has no
# user) came back as a bodyless 401 rather than a 404. Nothing in the log said the wrong
# version was running.
want_version="${PLUGIN_VERSION#v}"

installed_version() {
    mm GET /plugins 2>/dev/null | jq -r --arg id "$PLUGIN_ID" \
        '[(.active[]?), (.inactive[]?)] | map(select(.id == $id)) | .[0].version // ""'
}

have_version="$(installed_version || true)"

if [ "$have_version" = "$want_version" ]; then
    log "${PLUGIN_ID} ${have_version} already installed"
else
    log "installed ${PLUGIN_ID} is '${have_version:-none}', want ${want_version}: replacing"
    tmp=$(mktemp -d)
    curl -fsSL "$PLUGIN_URL" -o "${tmp}/agents.tar.gz" \
        || die "could not download ${PLUGIN_URL}"

    log "uploading the plugin ($(du -h "${tmp}/agents.tar.gz" | cut -f1))"
    # Check the status code. curl without -f treats an HTTP 400 as success, so the previous
    # version of this would have swallowed a min_server_version rejection silently.
    code=$(curl -sS -m 300 -o "${tmp}/upload.json" -w '%{http_code}' \
        -X POST "${MM}/api/v4/plugins" \
        -H "Authorization: Bearer ${MM_ADMIN_TOKEN}" \
        -F "plugin=@${tmp}/agents.tar.gz" -F 'force=true')
    if [ "$code" -lt 200 ] || [ "$code" -ge 300 ]; then
        warn "upload of ${PLUGIN_VERSION} returned HTTP ${code}:"
        head -c 500 "${tmp}/upload.json" >&2; echo >&2
        warn "Module 6's AI skill will not work. A min_server_version mismatch is the"
        warn "usual cause: check it against the Mattermost image in track/config.yml."
    fi
    rm -rf "$tmp"
fi

log "enabling ${PLUGIN_ID}"
mm POST "/plugins/${PLUGIN_ID}/enable" >/dev/null || warn "enable returned an error, continuing"

# Say which version is actually running. The whole failure above was invisible because
# nothing ever printed this.
now_version="$(installed_version || true)"
if [ "$now_version" = "$want_version" ]; then
    log "${PLUGIN_ID} ${now_version} is installed"
else
    warn "${PLUGIN_ID} is running '${now_version:-none}', not ${want_version}. The LLM"
    warn "Bridge that Module 6 calls may be missing."
fi

# ---------------------------------------------------------------------------
# 3. Verify the mock is actually reachable and answering
# ---------------------------------------------------------------------------
if curl -sf -m 10 "${LABSVC}/mock/llm/v1/models" >/dev/null 2>&1; then
    log "mock LLM is serving /models"
else
    warn "mock LLM did not answer at ${LABSVC}/mock/llm/v1/models. Is mm-labsvc running?"
fi

# ---------------------------------------------------------------------------
# 4. Verify Agents actually accepted the bot
# ---------------------------------------------------------------------------
# Writing the config is not the same as the plugin using it. Agents builds its bot lineup
# in EnsureBots, and a bot it rejects is skipped with a message that goes to the Mattermost
# server log, which is in another container and invisible from here. The visible symptom is
# a 404 "no bot found for service" from the LLM Bridge, at grading time, two challenges
# later.
#
# Creating a Mattermost bot account is the observable side effect of EnsureBots accepting a
# bot, so poll for that account and dump what is needed to diagnose it if it never appears.
log "verifying the Agents bot exists"
bot_ok=false
for _ in $(seq 1 15); do
    if mm GET "/users/username/${BOT_NAME}" >/dev/null 2>&1; then
        bot_ok=true
        break
    fi
    sleep 2
done

if [ "$bot_ok" = true ]; then
    log "bot ${BOT_NAME} exists, so Agents accepted the configuration"
else
    warn "bot ${BOT_NAME} was not created, so Agents rejected or ignored the bot config."
    warn "Module 6's AI skill will fail with 'no bot found for service: ${SERVICE_ID}'."
    warn "--- ${PLUGIN_ID} config as actually stored:"
    # Note the .Config indirection. Reading the top level here would show nothing even
    # when the settings are correct, which is exactly the confusion this whole path caused.
    mm GET /config 2>/dev/null |
        jq -c --arg id "$PLUGIN_ID" '.PluginSettings.Plugins[$id].Config
            | {services: [.services[]? | {id, type, apiURL}],
               bots: [.bots[]? | {name, serviceID}],
               defaultBotName}' >&2 || warn "(could not read the stored config)"
    warn "--- recent server log lines about the plugin:"
    # The admin log endpoint is the only view of the Mattermost container's log from here.
    #
    # The patterns are the ones Agents' own EnsureBots path emits, taken from
    # bots/bots.go and bots/getLLM. The last two matter most: getLLM returning an error
    # aborts EnsureBots before it publishes the bot list, so a single unusable service
    # leaves GetAllBots empty and every service reports "no bot found".
    mm GET "/logs?page=0&per_page=300" 2>/dev/null |
        jq -r '.[]?' 2>/dev/null |
        grep -iE "mattermost-ai|EnsureBots|Failed to ensure bot|Configured bot is not valid|Bot references|Unsupported service type|Bifrost" |
        tail -20 >&2 ||
        warn "(could not read the server log; EnableAdminLog may be off)"
fi

log "Agents configured against the mock LLM"
