# labsvc configuration.
#
# On Instruqt this file is written by the track setup script. Locally, copy it to .env and
# fill in the ids and tokens after seeding a Mattermost instance.

LABSVC_HOST=0.0.0.0
LABSVC_PORT=4000

# Must be reachable from the Mattermost SERVER process, not from the learner's browser.
# On Instruqt that is the internal host name. Never the env.play.instruqt.com form.
LABSVC_PUBLIC_BASE_URL=http://workbench:4000

HANDLER_URL=http://127.0.0.1:3000
MM_URL=http://127.0.0.1:8065

# Admin token. Grader and reset only. Never exposed to the handler or the learner.
MM_ADMIN_TOKEN=

# Bot token the mock feed posts with from Module 3 onward.
MM_FEED_BOT_TOKEN=

MM_ALERTS_CHANNEL_ID=
MM_INCIDENTS_CHANNEL_ID=

# Module 2 only. The learner creates this webhook, and the setup script or the learner
# writes the URL back here.
MM_FEED_INCOMING_WEBHOOK_URL=

# Module 2 only. Learner authored payload builder, exporting buildAlertPayload(alert).
# Unset to use the reference builder.
FEED_PAYLOAD_MODULE=/home/learner/handler/src/payloads/alert-payload.ts

JOURNAL_PATH=/var/lib/labsvc/journal.jsonl
JOURNAL_RING_SIZE=500
JOURNAL_MAX_BODY_BYTES=65536

FEED_INTERVAL_MS=60000
FEED_SEED=20260819
FEED_AUTOSTART=false

# Keep in sync with ServiceSettings.OutgoingIntegrationRequestsTimeout in the lab's
# Mattermost config.json, which the track sets to 5 seconds.
SLASH_ACK_BUDGET_MS=3000
HANDLER_TIMEOUT_MS=30000

# Drives feed transport selection and journal tagging. Bumped per module by Instruqt.
LAB_MODULE=2

LOG_LEVEL=info
