# Handler environment.
#
# On Instruqt this file is written for you by the track setup script. You should not need
# to edit it, but reading it is worth a minute: these are the values your code uses.

PORT=3000

# Mattermost REST API base, routed through the lab service so you can see your own calls
# in the Lab Inspector. It forwards verbatim and adds nothing.
MM_URL=http://workbench:4000/mm

# Site URL, for building permalinks. Not an API base.
MM_SITE_URL=http://mattermost:8065

# Your bot's token. Send it yourself as: Authorization: Bearer $MM_BOT_TOKEN
MM_BOT_TOKEN=

MM_TEAM_NAME=soc
MM_ALERTS_CHANNEL_ID=
MM_INCIDENTS_CHANNEL_ID=

# Tokens Mattermost sends in the request body. There is no signature header on these
# surfaces, so comparing these correctly is the whole security model.
MM_OUTGOING_WEBHOOK_TOKEN=
MM_COMMAND_TOKEN=

# Mock threat intel API, Module 4.
INTEL_API_URL=http://workbench:4000/mock/intel/v1

# Base URL for your own callback endpoints, used when building dialog and action URLs.
LABSVC_PUBLIC_BASE_URL=http://workbench:4000

LOG_LEVEL=info
